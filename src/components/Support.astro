---
import { payments } from '../data/payments';
---

<section id="support" data-nav="support" class="section-tight">
  <div class="container">
    <div class="support-head reveal">
      <div class="eyebrow">Never expected, always appreciated</div>
      <h2 class="section-title-sm">Support me</h2>
      <p class="support-sub">
        Tipping in person is always an option and never expected. If you'd rather send something
        online, here's the easiest way — every bit goes toward my kit, shears and licensing exam.
      </p>
    </div>
    <div class="support-grid">
      {payments.map((p) => (
        <a href={p.href} target="_blank" rel="noopener" data-spot data-analytics="support_click" data-method={p.method} class="support-card">
          <div class="support-method">{p.method}</div>
          <div class="support-value">{p.value}</div>
          <div class="support-action">Opens {p.method} →</div>
        </a>
      ))}
    </div>
    <p class="support-footnote">Cash in the chair works just as well.</p>
  </div>
</section>

<script>
  import { track } from '../scripts/analytics';

  document.querySelectorAll<HTMLAnchorElement>('[data-analytics="support_click"]').forEach((el) => {
    el.addEventListener('click', () => track('support_click', { method: el.dataset.method || '' }));
  });
</script>

<style>
  .support-head {
    text-align: center;
    margin-bottom: clamp(22px, 3vw, 32px);
  }
  .support-sub {
    margin: 0 auto;
    max-width: 48ch;
    color: var(--ink-3);
    font-size: 14px;
    line-height: 1.7;
    text-wrap: pretty;
  }
  .support-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
    max-width: 760px;
    margin-inline: auto;
  }
  .support-card {
    display: block;
    width: 100%;
    text-align: left;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
    color: var(--ink);
    transition: transform 0.28s cubic-bezier(0.2, 0.7, 0.2, 1), border-color 0.28s;
  }
  .support-card:hover {
    transform: translateY(-3px);
    border-color: var(--pink);
    color: var(--ink);
  }
  .support-method {
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 9px;
  }
  .support-value {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    line-height: 1.15;
  }
  .support-action {
    font-size: 12.5px;
    color: var(--ink-3);
    margin-top: 9px;
  }
  .support-footnote {
    margin: 18px auto 0;
    max-width: 60ch;
    text-align: center;
    font-size: 12.5px;
    color: var(--ink-3);
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .support-card {
      padding: 14px 16px;
    }
  }
</style>
