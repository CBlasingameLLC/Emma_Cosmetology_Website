          <input id="rv-name" type="text" placeholder="First name" class="field-input" />

          <label class="field-label">Stars</label>
          <div class="star-row">
            {[1, 2, 3, 4, 5].map((n) => (
              <button
                type="button"
                data-star={n}
                aria-label={`${n} star${n > 1 ? 's' : ''}`}
                class="star-btn"
              >
                ★
              </button>
            ))}
          </div>

          <label class="field-label" for="rv-text">How was it?</label>
          <textarea
            id="rv-text"
            rows="4"
            placeholder="She listened to exactly what I wanted…"
            class="field-textarea"
          ></textarea>

          <button type="submit" id="rv-submit" class="btn-submit">Post my review</button>
          <p class="form-note">
            Saved on this device for now — the live site will send it to Emma for approval before
            it shows up publicly.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

