      <div class="eyebrow">Kind words</div>
      <h2 class="section-title">From my chair</h2>
    </div>
    <div class="reviews-grid">
      <div>
        <div id="reviews-list" class="reviews-list" hidden></div>
        <div id="reviews-empty" class="reviews-empty">
          <div class="empty-medallion">✦</div>
          <h3 class="empty-title">The first review is still open</h3>
          <p class="empty-body">
