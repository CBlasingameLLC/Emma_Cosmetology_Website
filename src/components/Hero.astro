---
import { Image } from 'astro:assets';
import emmaChair from '../assets/emma-chair.jpg';
import { flatRate } from '../data/services';
---

<section data-nav="hero" class="hero">
  <div aria-hidden="true" class="hero-blob"></div>
  <div class="container hero-grid">
    <div class="hero-copy">
      <div class="pill">
        <span class="dot"></span>
        Now booking student clinic
      </div>
      <h1 class="hero-title">Hair that feels<br /><em>like you</em>.</h1>
      <p class="hero-body">
        I'm Emma — an 18-year-old cosmetology student at The Salon Professional Academy in
        Whitehouse, Texas. Come sit in my chair, tell me what you want, and let's make you feel
        beautiful.
      </p>
      <div class="hero-ctas">
        <a href="#book" class="btn-primary">Book an appointment</a>
        <a href="#quiz" class="btn-ghost">Take the hair quiz</a>
      </div>
      <div class="hero-stats">
        <div>
          <div class="stat-value">{flatRate}</div>
          <div class="stat-label">Flat academy rate</div>
        </div>
        <div>
          <div class="stat-value" data-countdown="days">—</div>
          <div class="stat-label">Days to licensing</div>
        </div>
        <div>
          <div class="stat-value">Whitehouse</div>
          <div class="stat-label">Tyler / East Texas</div>
        </div>
      </div>
    </div>
    <div data-tilt class="hero-photo-wrap">
      <div aria-hidden="true" class="hero-ring"></div>
      <Image
        src={emmaChair}
        alt="Emma Blasingame smiling at the salon counter"
        class="hero-photo"
        width={900}
        height={1125}
        widths={[400, 640, 900]}
        sizes="(min-width: 900px) 520px, 90vw"
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero-chip">
        <div class="chip-label">Behind the chair</div>
        <div class="chip-name">Emma Blasingame</div>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/countdown';
</script>

<style>
  .hero {
    position: relative;
    padding: clamp(48px, 7vw, 92px) 0 clamp(56px, 7vw, 100px);
  }
  .hero-blob {
    position: absolute;
    top: -160px;
    right: -140px;
    width: 560px;
    height: 560px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--pink-soft), transparent 68%);
    filter: blur(12px);
    pointer-events: none;
  }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(34px, 5vw, 70px);
    align-items: center;
  }
  .hero-copy {
    animation: riseIn 1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 7px 15px 7px 11px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: 11.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin-bottom: 26px;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--pink);
    box-shadow: 0 0 10px var(--glow);
    animation: blink 2.4s ease-in-out infinite;
  }
  .hero-title {
    font-size: clamp(46px, 7.6vw, 90px);
    line-height: 0.97;
    letter-spacing: -0.02em;
    margin: 0 0 22px;
  }
  .hero-title em {
    font-style: italic;
    color: var(--pink-2);
  }
  .hero-body {
    font-size: clamp(16px, 1.3vw, 18.5px);
    line-height: 1.72;
    color: var(--ink-2);
    max-width: 47ch;
    margin: 0 0 34px;
    text-wrap: pretty;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 36px;
  }
  .btn-primary {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 54px;
    padding: 16px 30px;
    border-radius: 999px;
    background: var(--pink);
    color: var(--onpink);
    font-size: 14.5px;
    letter-spacing: 0.06em;
    box-shadow: 0 12px 34px -12px var(--glow);
    transition: transform 0.28s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.28s;
  }
  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 50px -14px var(--glow);
    color: var(--onpink);
  }
  .btn-primary::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 40%;
    background: linear-gradient(90deg, transparent, color-mix(in oklab, var(--onpink) 40%, transparent), transparent);
    animation: sheen 3.4s ease-in-out infinite;
  }
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 54px;
    padding: 16px 28px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    font-size: 14.5px;
    letter-spacing: 0.06em;
    transition: border-color 0.25s, transform 0.25s, color 0.25s;
  }
  .btn-ghost:hover {
    border-color: var(--pink);
    color: var(--pink-2);
    transform: translateY(-3px);
  }
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 26px 40px;
    padding-top: 26px;
    border-top: 1px solid var(--line);
  }
  .stat-value {
    font-family: 'Cormorant Garamond', serif;
    font-size: 30px;
    line-height: 1;
    color: var(--pink-2);
  }
  .stat-label {
    font-size: 11.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-top: 6px;
  }
  .hero-photo-wrap {
    position: relative;
    transform-style: preserve-3d;
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
    animation: riseIn 1.1s 0.1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .hero-ring {
    position: absolute;
    inset: -16px;
    border-radius: 230px 230px 26px 26px;
    background: conic-gradient(from 0deg, var(--pink), var(--gold), var(--pink-soft), var(--pink));
    opacity: 0.5;
    filter: blur(22px);
    animation: spin 18s linear infinite;
  }
  .hero-photo {
    position: relative;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 22%;
    border-radius: 220px 220px 22px 22px;
    border: 1px solid var(--line);
  }
  .hero-chip {
    position: absolute;
    bottom: 22px;
    left: -14px;
    padding: 13px 19px;
    border-radius: 16px;
    background: color-mix(in oklab, var(--surface) 92%, transparent);
    backdrop-filter: blur(10px);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    animation: floaty 6s ease-in-out infinite;
  }
  .chip-label {
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .chip-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 20px;
    margin-top: 3px;
  }

  @media (max-width: 640px) {
    .hero {
      padding: 24px 0 clamp(40px, 8vw, 64px);
    }
    .hero-photo-wrap {
      width: 100%;
      max-width: 340px;
      margin-inline: auto;
    }
    .hero-photo {
      aspect-ratio: 3 / 4;
    }
    .hero-chip {
      left: 10px;
      bottom: 14px;
      padding: 10px 15px;
    }
  }
</style>
