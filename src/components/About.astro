---
import { Image } from 'astro:assets';
import emmaPortrait from '../assets/emma-portrait.jpg';
---

<section id="about" data-nav="about" class="section">
  <div class="container about-grid">
    <div data-tilt class="about-photo-wrap">
      <div aria-hidden="true" class="about-glow"></div>
      <Image
        src={emmaPortrait}
        alt="Emma Blasingame leaning against a column in a cream dress"
        class="about-photo"
        width={900}
        height={1125}
        widths={[400, 640, 900]}
        sizes="(min-width: 900px) 520px, 90vw"
        format="webp"
      />
      <div class="about-chip">
        <div class="chip-label">Est.</div>
        <div class="chip-year">2026</div>
      </div>
    </div>
    <div>
      <div class="eyebrow">Meet your stylist</div>
      <h2 class="section-title about-title">Hi, I'm Emma</h2>
      <div class="about-copy">
        <p>
          I've always been someone who loves being creative, and art has been a huge part of my
          life. Hair became another way for me to express that creativity while also getting to
          make people feel beautiful and confident. There's just something so special about
          sitting down with someone, getting to know them, and creating something they love.
        </p>
        <p>
          One of my favorite parts of doing hair is the connection with my clients. I want my
          chair to be a place where you feel comfortable being yourself, where you feel heard, and
          where you know you can trust me — like you're coming to see someone you genuinely enjoy
          spending time with.
        </p>
        <p>
          I'm definitely a girly girl at heart — pink is my favorite color, I love all things
          beauty, and I'm happiest when I'm creating something. I feel incredibly blessed to have
          the opportunity to pursue something I love, and I can't wait to see where this career
          takes me.
        </p>
      </div>
      <figure class="pull-quote">
        <blockquote>
          "Each of you should use whatever gift you have received to serve others, as faithful
          stewards of God's grace in its various forms."
        </blockquote>
        <figcaption>1 Peter 4:10</figcaption>
      </figure>
      <p class="about-closing">
        My biggest goal is simply to make people feel good about themselves and use the gifts God
        has given me to serve others. Thank you for being here and supporting me while I learn,
        grow, and build my career behind the chair. I can't wait to meet you.
      </p>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(34px, 5vw, 72px);
    align-items: center;
  }
  .about-photo-wrap {
    position: relative;
    transform-style: preserve-3d;
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .about-glow {
    position: absolute;
    inset: -18px;
    border-radius: 26px;
    background: linear-gradient(140deg, var(--pink-soft), transparent 60%, var(--pink-soft));
    opacity: 0.7;
    filter: blur(18px);
  }
  .about-photo {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: 22px;
    border: 1px solid var(--line);
  }
  .about-chip {
    position: absolute;
    top: 20px;
    right: -16px;
    padding: 12px 18px;
    border-radius: 14px;
    background: color-mix(in oklab, var(--surface) 92%, transparent);
    backdrop-filter: blur(10px);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    animation: floaty 7s ease-in-out infinite;
  }
  .chip-label {
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .chip-year {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    margin-top: 2px;
  }
  .about-title {
    margin: 0 0 24px;
  }
  .about-copy {
    display: grid;
    gap: 17px;
    color: var(--ink-2);
    font-size: 16px;
    line-height: 1.75;
    max-width: 52ch;
  }
  .about-copy p {
    margin: 0;
    text-wrap: pretty;
  }
  .pull-quote {
    margin: 30px 0 0;
    padding: 26px 28px;
    border-left: 2px solid var(--gold);
    background: var(--bg-2);
    border-radius: 0 16px 16px 0;
  }
  .pull-quote blockquote {
    margin: 0;
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-weight: 300;
    font-size: clamp(20px, 2.4vw, 26px);
    line-height: 1.4;
    color: var(--ink);
  }
  .pull-quote figcaption {
    margin-top: 14px;
    font-size: 11.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .about-closing {
    margin: 24px 0 0;
    color: var(--ink-2);
    font-size: 16px;
    line-height: 1.75;
    max-width: 52ch;
    text-wrap: pretty;
  }
</style>
