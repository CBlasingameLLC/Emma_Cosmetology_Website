---
import { contact } from '../data/contact';
---

<section id="book" data-nav="book" class="section section-band">
  <div class="container">
    <div class="book-head reveal">
      <div class="eyebrow">Let's get you in</div>
      <h2 class="section-title">Book with Emma</h2>
      <p class="book-sub">
        Send me a request and I'll confirm your time personally. Prefer to talk to a human? Call
        or text me directly.
      </p>
    </div>
    <div class="book-grid">
      <div data-spot class="book-form-card">
        <h3 class="form-title">Appointment request</h3>
        <form id="booking-form">
          <div class="field">
            <label class="field-label" for="f-name">Your name</label>
            <input id="f-name" type="text" placeholder="Emma's next client" class="field-input" />
          </div>
          <div class="field">
            <label class="field-label" for="f-service">What you'd like</label>
            <input id="f-service" type="text" placeholder="Haircut & style" class="field-input" />
          </div>
          <div class="field">
            <label class="field-label" for="f-when">When works for you</label>
            <input id="f-when" type="text" placeholder="Weekday afternoons, or this Saturday" class="field-input" />
          </div>
          <div class="field">
            <label class="field-label" for="f-notes">Anything I should know</label>
            <textarea id="f-notes" rows="4" placeholder="Hair history, inspo photos you'll bring, allergies…" class="field-textarea"></textarea>
          </div>
          <div class="book-actions">
            <a id="sms-link" href="#" class="btn-send">Send as text</a>
            <a id="mail-link" href="#" class="btn-send-outline">Send as email</a>
          </div>
          <p class="book-note">
            Opens your own messages app with everything filled in — nothing sends until you hit
            send.
          </p>
        </form>
      </div>
      <div class="book-side">
        <a id="call-direct" href={contact.phoneDirectHref} data-spot class="call-card">
          <div class="call-eyebrow">Book with me directly</div>
          <div class="call-number">{contact.phoneDirect}</div>
          <div class="call-note">Call or text — I answer texts fastest.</div>
        </a>
        <a id="call-academy" href={contact.phoneAcademyHref} data-spot class="call-card">
          <div class="call-eyebrow">Or through the academy</div>
          <div class="call-number">{contact.phoneAcademy}</div>
          <div class="call-note">{contact.academy} · Whitehouse, TX — ask for Emma.</div>
        </a>
        <div class="scheduler-slot">
          <div class="mono">[ online scheduler slot ]</div>
          <div class="scheduler-note">
            When Emma has a Square, Acuity or GlowUp account, its live calendar drops in right
            here — same styling, real time slots, no redesign needed.
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/booking';
</script>

<style>
  .book-head {
    text-align: center;
    margin-bottom: clamp(30px, 4vw, 48px);
  }
  .book-sub {
    margin: 0 auto;
    max-width: 50ch;
    color: var(--ink-2);
    font-size: 15.5px;
    line-height: 1.7;
    text-wrap: pretty;
  }
  .book-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(20px, 3vw, 30px);
    align-items: start;
  }
  .book-form-card {
    padding: clamp(24px, 3vw, 36px);
    border: 1px solid var(--line);
    border-radius: 22px;
    background: radial-gradient(520px circle at var(--mx, 50%) var(--my, 0%), var(--pink-soft), transparent 58%), var(--surface);
    box-shadow: var(--shadow);
  }
  .form-title {
    font-weight: 400;
    font-size: 28px;
    margin: 0 0 20px;
  }
  #booking-form {
    display: grid;
    gap: 16px;
  }
  .field-label {
    display: block;
    font-size: 11.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 8px;
  }
  .field-input,
  .field-textarea {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg-2);
    color: var(--ink);
    outline: none;
    transition: border-color 0.2s;
  }
  .field-input {
    min-height: 50px;
  }
  .field-textarea {
    resize: vertical;
    line-height: 1.6;
  }
  .field-input:focus,
  .field-textarea:focus {
    border-color: var(--pink);
  }
  .book-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 11px;
  }
  .btn-send {
    flex: 1 1 190px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 54px;
    padding: 15px 24px;
    border-radius: 999px;
    background: var(--pink);
    color: var(--onpink);
    font-size: 14.5px;
    letter-spacing: 0.05em;
    box-shadow: 0 12px 32px -14px var(--glow);
    transition: transform 0.25s, box-shadow 0.25s;
  }
  .btn-send:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 46px -16px var(--glow);
    color: var(--onpink);
  }
  .btn-send-outline {
    flex: 1 1 150px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 54px;
    padding: 15px 24px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    font-size: 14.5px;
    transition: border-color 0.25s, color 0.25s, transform 0.25s;
  }
  .btn-send-outline:hover {
    border-color: var(--pink);
    color: var(--pink-2);
    transform: translateY(-3px);
  }
  .book-note {
    margin: 0;
    font-size: 12.5px;
    color: var(--ink-3);
    line-height: 1.55;
  }
  .book-side {
    display: grid;
    gap: 16px;
  }
  .call-card {
    display: block;
    padding: 26px 28px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: radial-gradient(380px circle at var(--mx, 50%) var(--my, 0%), var(--pink-soft), transparent 60%), var(--surface);
    color: var(--ink);
    transition: transform 0.28s, border-color 0.28s;
  }
  .call-card:hover {
    transform: translateY(-4px);
    border-color: var(--pink);
    color: var(--ink);
  }
  .call-eyebrow {
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--pink-2);
    margin-bottom: 10px;
  }
  .call-number {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(28px, 3.4vw, 36px);
    line-height: 1;
  }
  .call-note {
    font-size: 13.5px;
    color: var(--ink-3);
    margin-top: 10px;
  }
  .scheduler-slot {
    padding: 24px 26px;
    border: 1px dashed var(--line);
    border-radius: 20px;
    background: var(--surface);
  }
  .mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11.5px;
    letter-spacing: 0.06em;
    color: var(--ink-3);
    margin-bottom: 10px;
  }
  .scheduler-note {
    font-size: 14.5px;
    color: var(--ink-2);
    line-height: 1.65;
  }
</style>
