---
import { services } from '../data/services';
---

<section id="services" data-nav="services" class="section">
  <div class="container">
    <div class="head-row reveal">
      <div>
        <div class="eyebrow">In the chair</div>
        <h2 class="section-title">Services &amp; rates</h2>
      </div>
      <p class="head-note">
        Prices are set by the academy, not by me — shown per service below. I'm still building
        speed as a student, so times run a little longer than a licensed stylist.
      </p>
    </div>
    <div class="service-grid">
      {services.map((service) => (
        <article data-spot class="service-card reveal">
          <div class="service-eyebrow">{service.category}</div>
          <h3 class="service-title">{service.title}</h3>
          <p class="service-desc">{service.description}</p>
          <div class="service-foot">
            <span>{service.duration}</span>
            <span class="service-price">{service.price}</span>
          </div>
        </article>
      ))}
    </div>
    <p class="footnote">
      Times are estimates — I'll confirm exactly what to expect when we talk. All services are
      performed at the academy under licensed instructor supervision.
    </p>
  </div>
</section>

<style>
  .head-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 26px;
    margin-bottom: clamp(34px, 4vw, 54px);
  }
  .head-note {
    max-width: 38ch;
    margin: 0;
    color: var(--ink-2);
    font-size: 15.5px;
    line-height: 1.7;
    text-wrap: pretty;
  }
  .head-note strong {
    color: var(--ink);
    font-weight: 500;
  }
  .service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(258px, 1fr));
    gap: 16px;
  }
  .service-card {
    background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 0%), var(--pink-soft), transparent 62%), var(--surface);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 26px;
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1), border-color 0.3s;
  }
  .service-card:hover {
    transform: translateY(-6px);
    border-color: var(--pink);
  }
  .service-eyebrow {
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--pink-2);
  }
  .service-title {
    font-weight: 400;
    font-size: 26px;
    margin: 11px 0 10px;
  }
  .service-desc {
    margin: 0 0 16px;
    color: var(--ink-2);
    font-size: 14.5px;
    line-height: 1.65;
  }
  .service-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    color: var(--ink-3);
  }
  .service-price {
    color: var(--pink-2);
    font-size: 15px;
  }
  .footnote {
    margin: 22px 0 0;
    font-size: 13.5px;
    color: var(--ink-3);
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .service-grid {
      gap: 12px;
    }
    .service-card {
      padding: 18px;
    }
    .service-title {
      font-size: 22px;
      margin: 9px 0 8px;
    }
  }
</style>
