---
import { showModelCall } from '../data/config';
import { flatRate } from '../data/services';

const spotlights = [
  { n: '01', title: 'Vivid color', body: 'Pinks, reds, coppers, pastels — bold color I can practice placement and processing on.' },
  { n: '02', title: 'Short cuts', body: 'Bobs, pixies, tapers and clipper work. Big-change cuts are the ones I need most.' },
  { n: '03', title: 'Perms & texture', body: 'Modern perms and texture waves — a required service and honestly a fun one.' },
  { n: '04', title: 'Updos', body: 'Formal styling and bridal-style pinning. Great if you have an event coming up.' },
];
---

{showModelCall && (
  <section id="models" data-nav="models" class="section section-band">
    <div class="container models-grid">
      <div class="reveal">
        <div class="pill pill-outline">
          <span class="dot"></span>
          Models wanted
        </div>
        <h2 class="section-title">Be a hair model</h2>
        <p class="models-intro">
          School requires me to complete specific looks before I graduate. If one of these is on
          your wish list, you get it for the flat academy rate and I get the hours — everybody
          wins.
        </p>
        <div class="terms">
          <div class="term"><span class="note-dot">✦</span><span>Flat <strong>{flatRate}</strong> academy rate, same as any service.</span></div>
          <div class="term"><span class="note-dot">✦</span><span>Plan for a longer appointment — my instructor checks the work at each step.</span></div>
          <div class="term"><span class="note-dot">✦</span><span>A licensed instructor supervises the entire service, start to finish.</span></div>
          <div class="term"><span class="note-dot">✦</span><span>I may photograph the result for my portfolio and socials — only ever with your permission.</span></div>
        </div>
        <a href="#book" class="btn-primary" data-analytics="model_cta_click">Volunteer as a model</a>
      </div>
      <div class="spotlight-grid reveal">
        {spotlights.map((s) => (
          <div data-spot class="spotlight-card">
            <div class="spotlight-num">{s.n}</div>
            <h3 class="spotlight-title">{s.title}</h3>
            <p class="spotlight-body">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<script>
  import { track } from '../scripts/analytics';
  document.querySelectorAll<HTMLElement>('[data-analytics="model_cta_click"]').forEach((el) => {
    el.addEventListener('click', () => track('model_cta_click'));
  });
</script>

<style>
  .models-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(30px, 4vw, 56px);
    align-items: start;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 7px 15px 7px 11px;
    border-radius: 999px;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .pill-outline {
    border: 1px solid var(--pink);
    background: var(--surface);
    color: var(--pink-2);
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--pink);
    box-shadow: 0 0 10px var(--glow);
    animation: blink 1.8s ease-in-out infinite;
  }
  .models-intro {
    margin: 20px 0 22px;
    color: var(--ink-2);
    font-size: 16px;
    line-height: 1.72;
    max-width: 46ch;
    text-wrap: pretty;
  }
  .terms {
    display: grid;
    gap: 11px;
    margin-bottom: 28px;
  }
  .term {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 14.5px;
    color: var(--ink-2);
    line-height: 1.6;
  }
  .note-dot {
    color: var(--pink);
    font-size: 12px;
    line-height: 1.7;
  }
  .term strong {
    color: var(--ink);
    font-weight: 500;
  }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 54px;
    padding: 16px 30px;
    border-radius: 999px;
    background: var(--pink);
    color: var(--onpink);
    font-size: 14.5px;
    letter-spacing: 0.05em;
    box-shadow: 0 12px 34px -12px var(--glow);
    transition: transform 0.28s, box-shadow 0.28s;
  }
  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 48px -14px var(--glow);
    color: var(--onpink);
  }
  .spotlight-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 14px;
  }
  .spotlight-card {
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: radial-gradient(340px circle at var(--mx, 50%) var(--my, 0%), var(--pink-soft), transparent 60%), var(--surface);
    transition: transform 0.3s, border-color 0.3s;
  }
  .spotlight-card:hover {
    transform: translateY(-5px);
    border-color: var(--pink);
  }
  .spotlight-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 34px;
    color: var(--pink-2);
    line-height: 1;
  }
  .spotlight-title {
    font-weight: 400;
    font-size: 22px;
    margin: 12px 0 8px;
  }
  .spotlight-body {
    margin: 0;
    font-size: 13.5px;
    color: var(--ink-2);
    line-height: 1.6;
  }
</style>
