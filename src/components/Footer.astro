---
import { contact } from '../data/contact';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="footer-brand">Blasingame Beauty</div>
        <p class="footer-blurb">Hair by Emma Blasingame — cosmetology student, East Texas.</p>
      </div>
      <div>
        <div class="footer-heading">Visit</div>
        <div class="footer-lines">
          <span>{contact.academy}</span>
          <span>{contact.city}</span>
        </div>
      </div>
      <div>
        <div class="footer-heading">Reach me</div>
        <div class="footer-lines">
          <a href={contact.phoneDirectHref}>{contact.phoneDirect} · direct</a>
          <a href={contact.phoneAcademyHref}>{contact.phoneAcademy} · academy</a>
        </div>
      </div>
      <div>
        <div class="footer-heading">Follow</div>
        <div class="footer-lines">
          <a href={contact.instagram} target="_blank" rel="noopener">{contact.instagramHandle} · Instagram</a>
          <a href={contact.tiktok} target="_blank" rel="noopener">{contact.tiktokHandle} · TikTok</a>
        </div>
      </div>
    </div>
    <div class="footer-legal">
      <span>© 2026 Emma Blasingame. Made with love by her brother.</span>
      <span>All services performed under licensed instructor supervision.</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: clamp(52px, 6vw, 80px) 0 40px;
    background: var(--bg-2);
    border-top: 1px solid var(--line);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 34px;
    padding-bottom: 34px;
    border-bottom: 1px solid var(--line);
  }
  .footer-brand {
    font-family: 'Cormorant Garamond', serif;
    font-size: 26px;
    margin-bottom: 10px;
  }
  .footer-blurb {
    margin: 0;
    font-size: 14px;
    color: var(--ink-3);
    line-height: 1.65;
    max-width: 30ch;
  }
  .footer-heading {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 14px;
  }
  .footer-lines {
    display: grid;
    gap: 8px;
    font-size: 14.5px;
    color: var(--ink-2);
  }
  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: space-between;
    padding-top: 26px;
    font-size: 12.5px;
    color: var(--ink-3);
  }
</style>
