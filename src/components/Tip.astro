---
import { payments } from '../data/payments';
---

<section id="tip" data-nav="tip" class="section section-band">
  <div class="container">
    <div class="tip-head">
      <div class="eyebrow">Never expected, always appreciated</div>
      <h2 class="section-title">Leave a tip</h2>
      <p class="tip-sub">
        The academy sets my rate, so tips aren't part of the price and never a requirement. If
        you'd like to bless me while I'm building my career, here's the easiest way — every bit
        goes toward my kit, shears and licensing exam.
      </p>
    </div>
    <div class="tip-grid">
      {payments.map((p) =>
        p.href ? (
          <a href={p.href} target="_blank" rel="noopener" data-spot data-analytics="tip_click" data-method={p.method} class="tip-card">
            <div class="tip-method">{p.method}</div>
            <div class="tip-value">{p.value}</div>
            <div class="tip-action">Opens {p.method} →</div>
          </a>
        ) : (
          <button type="button" id="zelle-btn" data-spot class="tip-card tip-card-btn">
            <div class="tip-method">{p.method}</div>
            <div class="tip-value">{p.value}</div>
            <div id="zelle-label" class="tip-action">Tap to copy · send in your bank app</div>
          </button>
        ),
      )}
    </div>
    <p class="tip-footnote">
      Cash in the chair is just as welcome.
      <span class="mono">[ confirm Venmo &amp; Cash App handles before launch ]</span>
    </p>
  </div>
</section>

<script>
  import { track } from '../scripts/analytics';

  document.querySelectorAll<HTMLAnchorElement>('[data-analytics="tip_click"]').forEach((el) => {
    el.addEventListener('click', () => track('tip_click', { method: el.dataset.method || '' }));
  });

  const zelleBtn = document.getElementById('zelle-btn');
  const zelleLabel = document.getElementById('zelle-label');
  zelleBtn?.addEventListener('click', async () => {
    track('tip_click', { method: 'Zelle' });
    try {
      await navigator.clipboard.writeText('903-730-1234');
    } catch {
      // clipboard unavailable; label still flips as feedback
    }
    if (zelleLabel) {
      zelleLabel.textContent = 'Number copied ♡';
      setTimeout(() => {
        zelleLabel.textContent = 'Tap to copy · send in your bank app';
      }, 2200);
    }
  });
</script>

<style>
  .tip-head {
    text-align: center;
    margin-bottom: clamp(28px, 3.5vw, 44px);
  }
  .tip-sub {
    margin: 0 auto;
    max-width: 52ch;
    color: var(--ink-2);
    font-size: 15.5px;
    line-height: 1.7;
    text-wrap: pretty;
  }
  .tip-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
    max-width: 900px;
    margin-inline: auto;
  }
  .tip-card {
    display: block;
    width: 100%;
    text-align: left;
    padding: 26px 24px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: radial-gradient(360px circle at var(--mx, 50%) var(--my, 0%), var(--pink-soft), transparent 60%), var(--surface);
    color: var(--ink);
    transition: transform 0.28s cubic-bezier(0.2, 0.7, 0.2, 1), border-color 0.28s;
  }
  .tip-card-btn {
    cursor: pointer;
  }
  .tip-card:hover {
    transform: translateY(-5px);
    border-color: var(--pink);
    color: var(--ink);
  }
  .tip-method {
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--pink-2);
    margin-bottom: 12px;
  }
  .tip-value {
    font-family: 'Cormorant Garamond', serif;
    font-size: 27px;
    line-height: 1.15;
  }
  .tip-action {
    font-size: 13.5px;
    color: var(--ink-3);
    margin-top: 12px;
  }
  .tip-footnote {
    margin: 22px auto 0;
    max-width: 60ch;
    text-align: center;
    font-size: 13px;
    color: var(--ink-3);
    line-height: 1.6;
  }
  .mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
</style>
